# Copia este archivo como .env solo para desarrollo local y cambia sus valores.
# En producción configura estas variables en Apache/cPanel. La aplicación no
# carga .env automáticamente y este archivo nunca debe contener secretos reales.

# Aplicación
APP_NAME="Ferretería Ayala"
APP_ENV=development
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=America/Hermosillo
APP_LOCALE=es_MX
APP_INDEXING=false

# Base de datos de la aplicación. Usa una cuenta sin privilegios administrativos.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ferreteria_ayala_dev
DB_USERNAME=usuario_local
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT=5
DB_MIGRATION_LOCK_TIMEOUT=10

# Integración MySQL/MariaDB. Solo tests/mysql-integration.php consume estas
# variables y exige APP_ENV=testing. Nunca reutiliza DB_* automáticamente.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_DATABASE=ferreteria_ayala_test
TEST_DB_USERNAME=usuario_pruebas
TEST_DB_PASSWORD=
TEST_DB_CHARSET=utf8mb4

# Sesiones (reservadas para autenticación; aún no se inician)
SESSION_NAME=ferreteria_ayala_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax
