# Copia este archivo como .env solo para desarrollo local y cambia sus valores.
# En producción configura estas variables en Apache/cPanel. Los comandos CLI
# cargan el .env local como datos; la aplicación web no lo carga automáticamente.
# Las variables ya exportadas tienen precedencia. Este archivo nunca contiene secretos reales.

# Aplicación
APP_NAME="Ferretería Ayala"
APP_ENV=development
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=America/Hermosillo
APP_LOCALE=es_MX
APP_INDEXING=false

# Base de datos de la aplicación. Usa una cuenta sin privilegios administrativos.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ferreteria_ayala_dev
DB_USERNAME=usuario_local
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT=5
DB_MIGRATION_LOCK_TIMEOUT=10

# Integración MySQL/MariaDB. Los ejecutores fuerzan APP_ENV=testing solo en su
# proceso, usan cuentas separadas por suite y nunca reutilizan DB_*.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_DATABASE=ferreteria_ayala_test
TEST_DB_USERNAME_M00=usuario_pruebas_m00
TEST_DB_PASSWORD_M00=
TEST_DB_USERNAME_M01=usuario_pruebas_m01
TEST_DB_PASSWORD_M01=
TEST_DB_USERNAME_M02=usuario_pruebas_m02
TEST_DB_PASSWORD_M02=
TEST_DB_CHARSET=utf8mb4

# M03 no hereda endpoint, base ni credenciales de otras suites.
TEST_DB_HOST_M03=127.0.0.1
TEST_DB_PORT_M03=3306
TEST_DB_DATABASE_M03=ferreteria_ayala_test
TEST_DB_USERNAME_M03=usuario_pruebas_m03
TEST_DB_PASSWORD_M03=
TEST_DB_CHARSET_M03=utf8mb4

# M04 tampoco hereda endpoint, base ni credenciales de otras suites.
TEST_DB_HOST_M04=127.0.0.1
TEST_DB_PORT_M04=3306
TEST_DB_DATABASE_M04=ferreteria_ayala_test
TEST_DB_USERNAME_M04=usuario_pruebas_m04
TEST_DB_PASSWORD_M04=
TEST_DB_CHARSET_M04=utf8mb4

# M05 usa identidad y endpoint de integración propios.
TEST_DB_HOST_M05=127.0.0.1
TEST_DB_PORT_M05=3306
TEST_DB_DATABASE_M05=ferreteria_ayala_test
TEST_DB_USERNAME_M05=usuario_pruebas_m05
TEST_DB_PASSWORD_M05=
TEST_DB_CHARSET_M05=utf8mb4

# Barrera adicional del ejecutor M01. Debe coincidir exactamente con
# TEST_DB_DATABASE al autorizar expresamente una ejecución real.
M01_TEST_AUTHORIZATION=
M02_TEST_AUTHORIZATION=
M03_TEST_AUTHORIZATION=
M04_TEST_AUTHORIZATION=
M05_TEST_AUTHORIZATION=

# Recuperación M01: permanecen vacías por defecto. Solo el ejecutor dedicado
# las consume tras una autorización separada; las rutas deben quedar fuera del
# repositorio y de public/. La confirmación de sesiones proviene de una revisión
# administrativa independiente, no concede privilegios globales a esta cuenta.
M01_RECOVERY_AUTHORIZATION=
M01_RECOVERY_CONFIRMATION=
M01_RECOVERY_SESSION_CONFIRMATION=
M01_RECOVERY_BACKUP_PATH=
M01_RECOVERY_BACKUP_MANIFEST=
M01_RECOVERY_BACKUP_SHA256=

# Sesiones (reservadas para autenticación; aún no se inician)
SESSION_NAME=ferreteria_ayala_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=43200
SESSION_SAVE_PATH=
