# Copia este archivo como .env solo para desarrollo local y cambia sus valores.
# En producción configura estas variables en Apache/cPanel. La aplicación no
# carga .env automáticamente y este archivo nunca debe contener secretos reales.

# Aplicación
APP_NAME="Ferretería Ayala"
APP_ENV=development
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=America/Hermosillo
APP_LOCALE=es_MX
APP_INDEXING=false

# Base de datos (reservada para la fase de persistencia; aún no se conecta)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ferreteria_ayala
DB_USERNAME=usuario_local
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Sesiones (reservadas para autenticación; aún no se inician)
SESSION_NAME=ferreteria_ayala_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax
