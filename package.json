{
  "name": "ferreteria-ayala-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "serve": "php -S 127.0.0.1:8080 -t public public/router.php",
    "test": "php tests/run.php",
    "test:mysql": "php tests/mysql-integration.php",
    "test:mysql:m01": "php tests/mysql-m01-integration.php",
    "test:mysql:m02": "php tests/mysql-m02-integration.php",
    "test:mysql:m02:http": "php tests/mysql-m02-http-integration.php",
    "test:mysql:m03": "php tests/mysql-m03-integration.php",
    "test:mysql:m03:http": "php tests/mysql-m03-http-integration.php",
    "inspect:mysql:m01-recovery": "php tests/mysql-m01-recovery.php inspect",
    "recover:mysql:m01-recovery": "php tests/mysql-m01-recovery.php recover",
    "test:browser": "node tests/browser.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "esbuild": "^0.25.0",
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@playwright/test": "^1.56.0"
  },
  "dependencies": {
    "swiper": "^12.0.0"
  },
  "overrides": {
    "@parcel/watcher": "^2.6.0"
  }
